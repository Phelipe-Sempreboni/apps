# URL base do Jira (NÃO coloque a barra no final)
JIRA_BASE_URL=https://suaorg.atlassian.net

# Usuário (e-mail da sua conta Atlassian/Jira)
JIRA_EMAIL=seu.email@empresa.com

# API Token (NUNCA comitar o .env real)
JIRA_API_TOKEN=coloque_seu_token_aqui

# Projeto e tipo de issue padrão
JIRA_PROJECT_KEY=SIRIUSDOCKER
JIRA_ISSUE_TYPE=Story
